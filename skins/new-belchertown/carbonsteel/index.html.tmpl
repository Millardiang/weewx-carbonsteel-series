#errorCatcher Echo
#encoding UTF-8
## weewx-carbonsteel-series: live gauges page for the Belchertown-new skin.
##
## Installed into the Belchertown skin (skins/new-belchertown/carbonsteel/)
## and generated by the Belchertown report itself, like its About and Records
## pages, so it gets Belchertown's own header, menu, theme switch and footer.
## The gauges' scripts, styles and data come from the CarbonSteelSeries (CS)
## folder; $Extras carbonsteel_url says where that is, relative to the
## Belchertown site root (the installer sets it).
#set global $page = "carbonsteel"
#set $cs_title = $Extras.get('carbonsteel_title', 'Live Gauges')

#include "header.html.tmpl"
## (the header sets $relative_url, so the CS folder is worked out after it)
#set $cs_url = $Extras.get('carbonsteel_url', '../CS/')
#if not ($cs_url.startswith('http') or $cs_url.startswith('/'))
#set $cs_url = $relative_url + '/' + $cs_url
#end if

<link rel="stylesheet" href="${cs_url}css/embed.css" type="text/css" media="all">

<div class="site-inner">
    <main class="content">
        <article class="weewx carbonsteel" itemscope itemtype="https://schema.org/CreativeWork">

            <div class="wx-stn-info-container">
                <div class="row">
                    <div class="col-md-6" style="padding-left:0;">
                        <div class="wx-stn-name">
                            <h1>$cs_title</h1>
                        </div>
                    </div>
                    <div class="col-md-5" style="float:right;">
                        <div class="wx-stn-info">
                            $obs.label.powered_by
                        </div>
                        #if $social_html != ""
                        <div class="col-md-10 wx-stn-info-social" style="float:right;">
                            $social_html
                        </div>
                        #end if
                    </div>
                </div>
                <div class="clear"></div>
            </div>

            <div class="cs-embed">
                <div class="cs-layout">

                    <section class="gauges" id="gauges" aria-label="Live gauges"></section>

                    <section class="panel" id="calendar-panel" aria-labelledby="cal-title" hidden>
                        <div class="panel-head">
                            <h2 id="cal-title">Year at a Glance</h2>
                            <div class="seg" id="cal-metric" role="tablist" aria-label="Calendar measure"></div>
                        </div>
                        <div class="calendar-scroll"><div id="calendar"></div></div>
                        <div class="cal-foot"><div id="cal-legend"></div><p id="cal-summary" class="muted"></p></div>
                    </section>

                </div>

                <dialog id="detail" aria-labelledby="detail-title">
                    <form method="dialog" class="detail-head">
                        <h2 id="detail-title">History</h2>
                        <button class="icon-btn" value="close" aria-label="Close">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        </button>
                    </form>
                    <div id="detail-chart"></div>
                </dialog>

                <div class="tooltip" id="tooltip" role="tooltip" hidden></div>
            </div>

        </article>
    </main>
</div>

## The gauges follow Belchertown: its light/dark theme, its units (this
## report's, or the visitor's choice if Belchertown's unit switcher is on),
## and its header, so the CarbonSteel header and switches are left out.
## If Belchertown shows live data over MQTT, the gauges use that broker too,
## with realtime.json for the day's figures (and as the fallback).
#set $cs_mqtt = $Extras.has_key("mqtt_websockets_enabled") and $Extras.mqtt_websockets_enabled == '1' and $Extras.get('mqtt_websockets_host', '') != ''
#if $cs_mqtt
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.1.0/paho-mqtt.min.js"></script>
#end if
<script>
window.CS_EMBED = {
    base_url: "$cs_url", theme: "host", controls: false, unit_switcher: "belchertown",
    display_units: {
        group_temperature: "$unit.unit_type.outTemp", group_pressure: "$unit.unit_type.barometer",
        group_speed: "$unit.unit_type.windSpeed", group_rain: "$unit.unit_type.rain",
        group_altitude: "$unit.unit_type.altitude"
    }#if $cs_mqtt#,
    mqtt: {
        host: "$Extras.mqtt_websockets_host", port: $Extras.get('mqtt_websockets_port', '1883'),
        ssl: #if $Extras.get('mqtt_websockets_ssl', '0') == '1'#true#else#false#end if#,
        topic: "$Extras.get('mqtt_websockets_topic', '')",
        username: $mqtt_websockets_username_json, password: $mqtt_websockets_password_json
    }#end if#
};
</script>
<script src="${cs_url}config.js"></script>
<script src="${cs_url}js/d3.min.js?v=7.9.0"></script>
<script src="${cs_url}js/gauges.js"></script>

#include "footer.html.tmpl"
